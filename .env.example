# Local backend environment variables for PHP.
# Copy this file to .env and update values for your local machine.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=fertilizer_shop

# Set this only if you deploy the React frontend separately from the PHP backend.
# Leave blank for local development when using Vite proxy.
VITE_API_BASE_URL=
