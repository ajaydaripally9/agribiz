<!DOCTYPE html>
<html>
<head>
<title>Update Fertilizer</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<h2>Update Product</h2>
<form method="POST" action="/update_fertilizer?id=<%= product.id %>">
<select name="category" required style="width: 100%; padding: 10px; margin-bottom: 15px; border-radius: 4px; border: 1px solid #ccc;">
    <option value="">Select Category</option>
    <option value="Seeds" <%= product.category === 'Seeds' ? 'selected' : '' %>>🌱 Seeds</option>
    <option value="Fertilizers" <%= product.category === 'Fertilizers' ? 'selected' : '' %>>🧪 Fertilizers</option>
    <option value="Pesticides" <%= product.category === 'Pesticides' ? 'selected' : '' %>>🚿 Pesticides</option>
    <option value="Organic" <%= product.category === 'Organic' ? 'selected' : '' %>>🍃 Organic</option>
    <option value="Tools" <%= product.category === 'Tools' ? 'selected' : '' %>>⚙️ Tools</option>
</select><br>
<input type="text" name="fertilizer_name" value="<%= product.fertilizer_name %>" required><br><br>
<input type="text" name="company_name" value="<%= product.company_name %>" required><br><br>
<input type="number" name="quantity" value="<%= product.quantity %>" required><br><br>
<label>Reorder Alert Level:</label><br><input type="number" name="reorder_level" value="<%= product.reorder_level || '10' %>" required><br><br>
<input type="number" step="0.01" name="price" value="<%= product.price %>" required><br><br>
<label>Purchase Price:</label><br><input type="number" step="0.01" name="purchase_price" value="<%= product.purchase_price || '0' %>"><br><br>
<label>HSN Code:</label><br><input type="text" name="hsn_code" value="<%= product.hsn_code || '' %>"><br><br>
<label>Batch No:</label><br><input type="text" name="batch_no" value="<%= product.batch_no || '' %>"><br><br>
<label>Mfg Date:</label><br><input type="date" name="mfg_date" value="<%= product.mfg_date_formatted || '' %>"><br><br>
<label>Expiry Date:</label><br><input type="date" name="expiry_date" value="<%= product.expiry_date_formatted || '' %>"><br><br>
<button type="submit" name="update" style="padding: 10px 20px; background-color: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer;">Update Product</button>
</form>
<a href="/view_fertilizer">Back</a>
</body>
</html>
