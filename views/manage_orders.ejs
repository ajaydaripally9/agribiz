<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Order Management — AgriBiz</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif;}
:root{--bg:#0d1117;--card:#161b22;--card2:#1c2333;--green:#22c55e;--blue:#3b82f6;--orange:#f59e0b;--red:#ef4444;--text:#e6edf3;--muted:#8b949e;--border:#30363d;}
body{background:var(--bg);color:var(--text);min-height:100vh;display:flex;}

.sidebar{width:220px;min-height:100vh;background:var(--bg);border-right:1px solid var(--border);position:fixed;left:0;top:0;bottom:0;z-index:100;display:flex;flex-direction:column;}
.sidebar-logo{padding:20px 16px;border-bottom:1px solid var(--border);}
.sidebar-logo h2{font-size:16px;font-weight:700;}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 16px;color:var(--muted);text-decoration:none;font-size:13px;border-left:3px solid transparent;transition:all .2s;}
.nav-item:hover,.nav-item.active{background:rgba(34,197,94,.08);color:var(--green);border-left-color:var(--green);}
.nav-item i{width:16px;}

.main{margin-left:220px;flex:1;padding:28px;}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;}
.header h1{font-size:22px;font-weight:700;} .header h1 span{color:var(--blue);}

/* Tabs */
.tabs{display:flex;gap:10px;margin-bottom:24px;border-bottom:1px solid var(--border);padding-bottom:10px;}
.tab{padding:8px 16px;border-radius:20px;background:var(--card2);color:var(--muted);font-weight:600;font-size:12px;cursor:pointer;border:1px solid var(--border);transition:.2s;display:flex;align-items:center;gap:8px;}
.tab:hover{border-color:var(--blue);color:var(--text);}
.tab.active{background:rgba(59,130,246,.15);color:var(--blue);border-color:rgba(59,130,246,.3);}
.tab-badge{background:var(--red);color:#fff;padding:2px 6px;border-radius:10px;font-size:10px;font-weight:800;}

/* Order Cards */
.order-grid{display:grid;gap:16px;}
.order-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:20px;transition:.2s;}
.order-card:hover{border-color:var(--blue);}
.order-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;border-bottom:1px solid var(--border);padding-bottom:16px;}
.invoice-no{font-size:12px;color:var(--muted);font-weight:600;}
.customer-name{font-size:15px;font-weight:700;color:var(--text);margin-top:4px;}
.order-date{font-size:11px;color:var(--muted);}
.order-body{display:grid;grid-template-columns:2fr 1fr 1fr;gap:20px;align-items:center;margin-bottom:20px;}
.product-list{font-size:13px;color:var(--text);font-weight:500;}
.price-box{text-align:center;}
.price-val{font-size:18px;font-weight:800;color:var(--green);}
.coins-val{font-size:12px;font-weight:700;color:var(--orange);}

.order-footer{display:flex;justify-content:space-between;align-items:center;}
.status-pill{padding:4px 10px;border-radius:12px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.5px;}
.status-pending{background:rgba(245,158,11,.15);color:var(--orange);}
.status-accepted{background:rgba(34,197,94,.15);color:var(--green);}
.status-shipped{background:rgba(59,130,246,.15);color:var(--blue);}
.status-rejected{background:rgba(239,68,68,.15);color:var(--red);}

.action-group{display:flex;gap:8px;}
.btn{padding:8px 14px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;border:none;transition:.2s;text-decoration:none;display:flex;align-items:center;gap:6px;}
.btn-primary{background:rgba(59,130,246,.15);color:var(--blue);border:1px solid rgba(59,130,246,.3);}
.btn-primary:hover{background:rgba(59,130,246,.25);}
.btn-outline{background:var(--card2);border:1px solid var(--border);color:var(--text);}
.btn-outline:hover{border-color:var(--muted);}

.alert{background:rgba(34,197,94,.1);color:var(--green);border:1px solid rgba(34,197,94,.3);padding:12px 16px;border-radius:10px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;font-weight:600;font-size:13px;}
.tab-panel{display:none;}
.tab-panel.active{display:block;}

.empty-state{text-align:center;padding:40px;color:var(--muted);}
.empty-state i{font-size:32px;margin-bottom:12px;opacity:0.5;}

@keyframes fadeSlideUp {
  0% { opacity: 0; transform: translateY(20px); }
  100% { opacity: 1; transform: translateY(0); }
}
.animated-card {
  animation: fadeSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  opacity: 0;
}
</style>
</head>
<body>

<%- include('partials/sidebar') %>

<main class="main">
  <div class="header">
    <div>
      <h1>Manage <span>Orders</span></h1>
      <p style="font-size:12px;color:var(--muted);margin-top:4px;">Process and track customer e-commerce orders</p>
    </div>
    <div style="background:var(--card2); padding:6px 12px; border-radius:8px; border:1px solid var(--border); font-size:11px; font-weight:600; color:var(--text);">
      <i class="fas fa-sync fa-spin" style="color:var(--green);"></i> Live Sync
    </div>
  </div>

  <% if (message) { %>
  <div class="alert">
    <span><i class="fas fa-check-circle"></i> <%= message %></span>
    <% if (typeof wa_link !== 'undefined' && wa_link) { %>
    <a href="<%= wa_link %>" target="_blank" class="btn" style="background:#25D366;color:white;border:none;"><i class="fab fa-whatsapp"></i> Notify</a>
    <% } %>
  </div>
  <% } %>

  <div class="tabs">
    <div class="tab active" onclick="switchTab('pending', this)">
      <i class="fas fa-clock"></i> Pending 
      <% if (pendingOrders.length > 0) { %><span class="tab-badge"><%= pendingOrders.length %></span><% } %>
    </div>
    <div class="tab" onclick="switchTab('accepted', this)"><i class="fas fa-box-open"></i> Accepted</div>
    <div class="tab" onclick="switchTab('shipped', this)"><i class="fas fa-truck"></i> Shipped/Completed</div>
    <div class="tab" onclick="switchTab('rejected', this)"><i class="fas fa-times-circle"></i> Rejected</div>
  </div>

  <div class="tab-content">
    <% function renderOrderList(ordersList, emptyText) { %>
      <% if (ordersList.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-clipboard-list"></i>
          <p><%= emptyText %></p>
        </div>
      <% } else { %>
        <div class="order-grid">
          <% ordersList.forEach((order, idx) => { %>
          <div class="order-card animated-card" style="animation-delay:<%= idx * 0.1 %>s">
            <div class="order-header">
              <div>
                <div class="invoice-no">Order #<%= order.id %></div>
                <div class="customer-name"><%= order.customer_name %></div>
                <div style="font-size:11px;color:var(--muted);margin-top:2px;"><i class="fas fa-phone"></i> <%= order.mobile %></div>
              </div>
              <div class="order-date"><%= new Date(order.order_date).toLocaleString() %></div>
            </div>
            
            <div class="order-body">
              <div>
                <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:6px;text-transform:uppercase;">Items</div>
                <div class="product-list">
                  <% 
                    let items = []; 
                    try { items = JSON.parse(order.items_json); } catch(e) {} 
                  %>
                  <% items.forEach(item => { %>
                    <div style="margin-bottom:4px;"><span style="color:var(--green);font-weight:700;"><%= item.qty %>x</span> <%= item.name %></div>
                  <% }) %>
                </div>
              </div>
              <div class="price-box">
                <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:4px;text-transform:uppercase;">Total</div>
                <div class="price-val">₹<%= order.grand_total.toFixed(2) %></div>
              </div>
              <div class="price-box">
                <div style="font-size:11px;font-weight:700;color:var(--muted);margin-bottom:4px;text-transform:uppercase;">Coins</div>
                <div class="coins-val">+<%= order.earned_coins %> <i class="fas fa-coins"></i></div>
              </div>
            </div>

            <div class="order-footer">
              <span class="status-pill status-<%= order.status.toLowerCase() %>">
                <i class="fas fa-circle" style="font-size:6px;vertical-align:middle;margin-right:4px;"></i> <%= order.status %>
              </span>
              
              <div class="action-group">
                <% if (order.status === 'Pending') { %>
                  <form action="/manage_orders" method="POST" style="display:inline;">
                    <input type="hidden" name="order_id" value="<%= order.id %>">
                    <input type="hidden" name="action" value="accept">
                    <button type="submit" class="btn btn-primary" style="background:rgba(34,197,94,.15);color:var(--green);border-color:rgba(34,197,94,.3);"><i class="fas fa-check"></i> Accept</button>
                  </form>
                  <form action="/manage_orders" method="POST" style="display:inline;">
                    <input type="hidden" name="order_id" value="<%= order.id %>">
                    <input type="hidden" name="action" value="reject">
                    <button type="submit" class="btn btn-outline" style="color:var(--red);border-color:rgba(239,68,68,.3);"><i class="fas fa-times"></i> Reject</button>
                  </form>
                <% } else if (order.status === 'Accepted') { %>
                  <form action="/manage_orders" method="POST" style="display:inline;">
                    <input type="hidden" name="order_id" value="<%= order.id %>">
                    <input type="hidden" name="action" value="ship">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-truck-fast"></i> Mark Shipped</button>
                  </form>
                <% } %>
                <a href="/view_invoice?id=<%= order.id %>" target="_blank" class="btn btn-outline"><i class="fas fa-file-invoice"></i> Bill</a>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      <% } %>
    <% } %>

    <div id="pending" class="tab-panel active"><% renderOrderList(pendingOrders, "No pending orders to review.") %></div>
    <div id="accepted" class="tab-panel"><% renderOrderList(acceptedOrders, "No accepted orders waiting to be shipped.") %></div>
    <div id="shipped" class="tab-panel"><% renderOrderList(shippedOrders, "No shipped orders yet.") %></div>
    <div id="rejected" class="tab-panel"><% renderOrderList(rejectedOrders, "No rejected orders.") %></div>
  </div>
</main>

<script>
function switchTab(tabId, el) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
  document.getElementById(tabId).classList.add('active');
}
</script>
</body>
</html>
